# ==============================================================================
# MT5 Gold Scalper Bot - Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# MT5 Account Credentials
MT5_LOGIN=12345678
MT5_PASSWORD=YourDemoPasswordHere
MT5_SERVER=MetaQuotes-Demo
# Optional custom MT5 terminal path (leave blank if standard installation)
MT5_PATH=

# Safety Flag (Must be False for Demo/Contest accounts, True required for Real accounts)
ALLOW_LIVE_TRADING=False

# Strategy & Asset
SYMBOL=XAUUSD
TIMEFRAME=M1

# Risk & Spread
MAX_SPREAD_PRICE=0.40
RISK_PER_TRADE_PCT=1.0
# Optional fixed risk in account currency (e.g. 2000 in NGN account or 2.0 in USD account). Overrides pct if > 0.
FIXED_RISK_AMOUNT=
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
MAX_CONCURRENT_TRADES=1
SLIPPAGE_POINTS=20

# Telegram Notifications (Optional - leave blank if not used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
